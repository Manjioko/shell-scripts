#!/usr/bin/expect -f
# expect 驱动:模拟"续行 + 多行粘贴(末尾无换行)"
set timeout 10
spawn /opt/homebrew/bin/bash /Users/manjioko/shell-scripts/paste_repro.sh

expect ".. " { }
# 输入 nihao\ 回车(进入续行)
send -- "nihao\\\r"
sleep 0.3
expect ".. " { }

# 一次性发送整段粘贴(与终端模拟器快速灌入类似),末尾无换行
send -- "Hello World from FreeRTOS task!\r\nTask created successfully\r\nTask deleted successfully\r\nI (273) main_task: Returned from app_main()"
sleep 1.0

# 结束会话(此时新 prompt 已出现,直接发送 END 回车)
send -- "END\r"
expect {
    "=== END INPUT ===" { }
    timeout { puts "TIMEOUT waiting for END INPUT"; exit 1 }
}

puts "\n===== SESSION BUFFER (终端回显全貌) ====="
puts $expect_out(buffer)
expect eof
